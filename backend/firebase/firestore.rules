rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Vendors collection
    // - Anyone can create (register)
    // - Only the vendor themselves can read/update their own record
    match /vendors/{email} {
      allow create: if true;
      allow read, update: if request.auth == null || resource.data.email == email;
    }

  }
}
